source | extend d=todynamic(RawData) | project Source_ip=tostring(d.SrcIP),TimeGenerated,TimeIngested=tostring(d.Time),Method=tostring(d.Method),Request=tostring(d.Request),Response=tostring(d.Response), RawData

KQL Transitional scaler query for Apache Access log
source | extend d=split(RawData," ") | project Src_IP=tostring(d[0]),TimeGenerated=todatetime(strcat(d[3]," ",d[4])),Method=tostring(d[5]),Request=tostring(d[6]),Response=tostring(d[8]),Size=toint(d[9]),Referrer=tostring(d[10]),UserAgent=tostring(d[11]),Computer=tostring(d[12]), RawData

KQL Transitional scaler query for Apache Error log
source | extend d=split(RawData," ") | project TimeGenerated=todatetime(strcat(d[3]," ",d[4])),Source=tostring(d[5]),Process=tostring(d[6]),ErrorMSG=tostring(d[7]), RawData


KQL Transitional scaler query for Apache Access log (2)

source | extend Raw=tostring(RawData) | extend d=split(Raw," ") | extend SrcIP=tostring(d[0]), TimeGenerated=todatetime(replace("\\]", "", replace("\\[", "", strcat(d[3], " ", d[4])))), Method=trim('"', tostring(d[5])), Request=tostring(d[6]), HTTPcode=tostring(d[8]), Size=toint(d[9]), Referrer=iif(array_length(d) > 10, tostring(d[10]), ""), UserAgent=trim('"', strcat(iif(array_length(d) > 11, tostring(d[11]), ""), " ", iif(array_length(d) > 12, tostring(d[12]), ""), " ", iif(array_length(d) > 13, tostring(d[13]), ""), " ", iif(array_length(d) > 14, tostring(d[14]), ""))), Computer="", RawData=Raw | project SrcIP, TimeGenerated, Method, Request, HTTPcode, Size, UserAgent, Computer, RawData


KQL Transitional scaler query for Apache error log (2)
source | extend Raw=tostring(RawData) | extend parts=split(Raw, " ") | extend TimeGenerated=todatetime(strcat(substring(Raw, 1, 24), "Z")), Module=replace("[:\\]]", "", tostring(parts[5])), LogLevel=replace("[:\\]]", "", tostring(parts[6])), ProcessID=replace("pid", "", replace(":", "", tostring(parts[7]))), ThreadID=replace("tid", "", replace("]", "", tostring(parts[8]))), ClientIP=replace(":", "", replace("]", "", tostring(parts[10]))), ClientPort=replace("]", "", tostring(parts[11])), ErrorCode=iif(array_length(parts) > 12, replace(":", "", tostring(parts[12])), ""), ErrorMsg=trim(":", strcat(iif(array_length(parts) > 13, tostring(parts[13]), ""), " ", iif(array_length(parts) > 14, tostring(parts[14]), ""), " ", iif(array_length(parts) > 15, tostring(parts[15]), ""), " ", iif(array_length(parts) > 16, tostring(parts[16]), ""), " ", iif(array_length(parts) > 17, tostring(parts[17]), ""))), RawData=Raw | project TimeGenerated, Module, LogLevel, ProcessID, ThreadID, ClientIP, ClientPort, ErrorCode, ErrorMsg, RawData

